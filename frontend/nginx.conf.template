# Pages and API share one origin: the session cookie never crosses origins.
server {
    listen 80;
    root /usr/share/nginx/html;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Server-sent events: no buffering, and a read timeout longer than an investigation.
    location ~ ^/api/(investigations/[^/]+/events|sessions/[^/]+/messages)$ {
        proxy_pass ${BIANQUE_BACKEND_URL};
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass ${BIANQUE_BACKEND_URL};
    }

    location /mcp {
        proxy_pass ${BIANQUE_BACKEND_URL};
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location = /healthz {
        proxy_pass ${BIANQUE_BACKEND_URL};
    }

    # Assets carry a content hash in their names; the page itself must not be cached.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
